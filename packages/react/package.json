{
  "name": "bloom-color-picker",
  "version": "0.1.1",
  "description": "A flower-inspired color picker — a swatch that blooms open into petals. Zero dependencies.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shivraj-roy/bloom-color-picker.git",
    "directory": "packages/react"
  },
  "homepage": "https://bloom-color-picker.shivrajroy.in",
  "bugs": {
    "url": "https://github.com/shivraj-roy/bloom-color-picker/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/index.css"
    }
  },
  "tsup": {
    "entry": [
      "src/index.tsx"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "bundle": true,
    "clean": true,
    "dts": true,
    "injectStyle": false,
    "outDir": "./dist",
    "banner": {
      "js": "\"use client\";"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup --minify && node -e \"fs.writeFileSync('dist/style.css.d.ts', 'export {};\\n')\"",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "color picker",
    "color",
    "picker",
    "bloom",
    "flower",
    "react"
  ],
  "author": "Shivraj Roy <shivrajroy78@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19",
    "react": "^19.0.0",
    "tsup": "8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}

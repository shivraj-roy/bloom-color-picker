{
   "compilerOptions": {
      "target": "ES2020",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "moduleResolution": "bundler",
      "strict": true,
      "noEmit": true,
      "skipLibCheck": true,
      "isolatedModules": true,
      "verbatimModuleSyntax": true,
      "allowJs": true,
      "checkJs": false
   },
   "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"]
}

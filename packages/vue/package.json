{
  "name": "bloom-color-picker-vue",
  "version": "0.0.0",
  "description": "A flower-inspired color picker \u2014 a swatch that blooms open into petals. Zero dependencies. Vue 3.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivraj-roy/bloom-color-picker.git",
    "directory": "packages/vue"
  },
  "homepage": "https://bloom-color-picker.shivrajroy.in",
  "bugs": {
    "url": "https://github.com/shivraj-roy/bloom-color-picker/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/bloom-color-picker-vue.css"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly && node -e \"fs.writeFileSync('dist/style.css.d.ts', 'export {};\\n')\"",
    "check-types": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "color picker",
    "color",
    "picker",
    "bloom",
    "flower",
    "vue"
  ],
  "author": "Shivraj Roy <shivrajroy78@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
